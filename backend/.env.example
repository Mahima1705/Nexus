# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Project ---
PROJECT_NAME=Nexus
ENVIRONMENT=development

# --- CORS (comma-separated origins) ---
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
SYNC_DATABASE_URL=postgresql+psycopg2://nexus:nexus@localhost:5432/nexus

# --- JWT ---
SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=nexus_repo_
VECTOR_SIZE=1536

# --- LLM provider: "openai" or "claude" ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-sonnet-4-20250514

# --- Embeddings: "openai" or "bge" ---
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=200

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO
LOG_JSON=false
