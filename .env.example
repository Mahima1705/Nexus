# Copy to .env before running `docker compose up`. docker-compose.yml reads this
# file automatically (it's in the same directory) for ${VAR} substitution.
# Everything has a sensible default for local development except the API keys —
# without one of those, the app runs fully (auth, uploads, browsing) but AI
# features (chat/search/review/errors/docs) will fail with a clear error.

# --- Ports (host-side; change if any of these are already taken) ---
POSTGRES_PORT=5432
QDRANT_PORT=6333
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- PostgreSQL ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexus

# --- Qdrant ---
QDRANT_API_KEY=

# --- CORS: origins allowed to call the backend (comma-separated) ---
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- JWT — generate a real value: `openssl rand -hex 32` ---
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_ENV_FILE
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM provider: "openai" or "claude" ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
ANTHROPIC_API_KEY=
CLAUDE_CHAT_MODEL=claude-sonnet-4-20250514

# --- Embeddings: "openai" or "bge" (bge runs locally, no key needed, but needs
# sentence-transformers installed — see backend/requirements.txt) ---
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Frontend: the URL the BROWSER uses to reach the backend (not the internal
# Docker network address) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

LOG_LEVEL=INFO
